+-- Patched: upstream flushes this queue from a repeating timer (refresh_time,
+-- default 16ms). That timer runs forever, so an idle or unfocused nvim keeps
+-- waking the event loop. Instead the queue arms a one-shot `vim.schedule`
+-- flush, which runs on the next event-loop iteration -- sooner than any tick,
+-- and free when nothing is happening.
+local flush_scheduled = false
+local check_refresh
+
 ---@alias LualineRefreshOptsKind
 ---| 'all'
 ---| 'tabpage'
@@ -372,6 +380,18 @@
       refresh_event_queue['has_events'] = true
       refresh_event_queue[place] = vim.tbl_extend('force', opts, { place = { place }, queued = true })
     end
+    -- Patched: flush on the next loop iteration instead of waiting for a
+    -- periodic tick. Bursts within one iteration still coalesce into a single
+    -- redraw, which is what the timer was providing.
+    if not flush_scheduled then
+      flush_scheduled = true
+      vim.schedule(function()
+        flush_scheduled = false
+        if check_refresh then
+          check_refresh()
+        end
+      end)
+    end
     return
   end
 
